generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EDITOR
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  HIDDEN
}

enum StreamType {
  HLS
  M3U8
  RTMP
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(EDITOR)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Channel {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  description String?
  logo        String?
  coverImage  String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  videos      Video[]
  programs    Program[]
  liveStreams LiveStream[]
}

model Program {
  id          String   @id @default(cuid())
  name        String
  slug        String
  description String?
  coverImage  String?
  channelId   String
  channel     Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  videos      Video[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([channelId, slug])
}

model Video {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  description String?
  videoUrl    String
  thumbnail   String?
  duration    Int?
  category    String?
  tags        String        @default("")
  views       Int           @default(0)
  status      ContentStatus @default(DRAFT)
  featured    Boolean       @default(false)
  channelId   String?
  channel     Channel?      @relation(fields: [channelId], references: [id], onDelete: SetNull)
  programId   String?
  program     Program?      @relation(fields: [programId], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([views])
  @@index([channelId])
}

model LiveStream {
  id          String     @id @default(cuid())
  title       String
  slug        String     @unique
  description String?
  streamUrl   String
  streamType  StreamType @default(HLS)
  thumbnail   String?
  isActive    Boolean    @default(false)
  viewerCount Int        @default(0)
  channelId   String?
  channel     Channel?   @relation(fields: [channelId], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model SiteSettings {
  id    String @id @default("default")
  key   String @unique
  value String
}
